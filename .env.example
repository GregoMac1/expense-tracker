# Telegram bot token (creado via @BotFather)
TELEGRAM_BOT_TOKEN=

# Tu user id de Telegram (podés obtenerlo hablando con @userinfobot)
# Solo los mensajes de este user van a ser procesados.
TELEGRAM_ALLOWED_USER_ID=

# Ollama local
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# DB (SQLite)
DB_PATH=./data/tracker.db

# API de cotización del dólar. Opciones en https://dolarapi.com:
#   /v1/dolares/bolsa   ← MEP/Bolsa (recomendado para poder adquisitivo real)
#   /v1/dolares/blue    ← Dólar blue
#   /v1/dolares/oficial ← Dólar oficial
DOLLAR_API_URL=https://dolarapi.com/v1/dolares/bolsa

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info
