{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Personal expense tracker with Telegram bot + local LLM",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "DB_PATH=./data/demo.db tsx scripts/seed-demo.ts",
    "demo": "DB_PATH=./data/demo.db tsx src/index.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.5",
    "node-telegram-bot-api": "^0.66.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/node-telegram-bot-api": "^0.64.7",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
